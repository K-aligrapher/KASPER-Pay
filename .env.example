# Copy to .env (never commit .env). Every value is optional; defaults are shown.
# KASPER also reads %LOCALAPPDATA%\KASPER\settings.json.
KASPER__Ollama__BaseUrl=http://127.0.0.1:11434
KASPER__Ollama__Model=qwen2.5-coder:7b
KASPER__Ollama__TimeoutSeconds=300
KASPER__Ollama__KeepAlive=30m

# PayPal sandbox (KASPER Pay). Prefer .NET user secrets so nothing sits in a file:
#   dotnet user-secrets set "PayPal:ClientId" "<sandbox client id>" --project src/Kasper.Api
#   dotnet user-secrets set "PayPal:ClientSecret" "<sandbox secret>" --project src/Kasper.Api
#   dotnet user-secrets set "PayPal:Environment" "sandbox" --project src/Kasper.Api
# Env-var form (leave blank in anything you commit):
KASPER__PayPal__ClientId=
KASPER__PayPal__ClientSecret=
KASPER__PayPal__Environment=sandbox
KASPER__Payments__Currency=USD
KASPER__Payments__PerTransactionLimit=100.00
KASPER__Payments__DailyLimit=250.00
KASPER__Payments__DuplicateWindowMinutes=10

# Live product search (Channel3). Prefer user secrets:
#   dotnet user-secrets set "Channel3:ApiKey" "<your Channel3 key>" --project src/Kasper.Api
# Leave blank to search the 8 built-in demo products instead.
KASPER__Channel3__ApiKey=
# Spending mandate (0 = off): purchases up to this amount skip KASPER's review card. PayPal still asks you.
KASPER__Payments__AutoApproveUnder=0
KASPER__Payments__AutoApproveWeeklyCap=50.00
# UI only (ui/.env.local, gitignored): optional AG Grid Enterprise key. Without it the grid runs in community mode.
# VITE_AG_GRID_LICENSE=
