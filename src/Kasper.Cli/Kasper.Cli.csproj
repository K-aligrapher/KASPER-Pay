<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The command you type: kasper -->
    <AssemblyName>kasper</AssemblyName>
    <RootNamespace>Kasper.Cli</RootNamespace>
    <ApplicationIcon>..\..\assets\brand\kasper.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kasper.Application\Kasper.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same pixel grid as the UI and icons. -->
    <EmbeddedResource Include="..\..\assets\brand\kasper-logo.grid.txt" LogicalName="kasper-logo.grid.txt" />
  </ItemGroup>

</Project>
