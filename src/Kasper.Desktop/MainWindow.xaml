<Window x:Class="Kasper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="KASPER"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0D0D0D" Visibility="Hidden" />
        <!-- Splash until the UI has loaded -->
        <StackPanel x:Name="Splash" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="SplashBunny" Width="128" Height="128" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <TextBlock Text="KASPER" Foreground="#F5B800" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas" />
            <TextBlock Text="waking up…" Foreground="#A3A3A3" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Window>
